# Environment Variables for musafir

# ─── Supabase (User Auth & Database) ────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google Gemini AI (Musafir AI Assistant) ─────────────────────────────────
# Get free key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ─── OLA Maps (Pan-India Map & Routing API) ───────────────────────────────────
# Get free key (1M calls/month) from: https://maps.olakrutrim.com
VITE_OLA_MAPS_API_KEY=your-ola-maps-api-key-here
